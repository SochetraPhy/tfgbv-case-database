# Copy to .env and set every value. Never commit .env.

# Application secret used to sign tokens. Generate with: openssl rand -hex 32
SECRET=replace-with-a-32-byte-random-hex-string

# The URL the application is served from. Must match how users reach it,
# or asset links and OAuth redirects will break.
PUBLIC_URL=http://localhost:8055

# First administrator. Applied ONLY when the database is empty —
# changing these later has no effect. Change the password in the app instead.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=replace-with-a-strong-password

# PostgreSQL
DB_DATABASE=directus
DB_USER=directus
DB_PASSWORD=replace-with-a-strong-password
